# ------------------------------------------------------------------
# AuditX backend — Render environment variables
# copy to .env (never commit .env) or set directly in Render dashboard
# run locally with:  node --env-file=.env dist/server.js
# ------------------------------------------------------------------

# Server
PORT=8080

# Firebase Admin (from Firebse Console > Project Settings > Service accounts > Generate new private key)
# PROJECT_ID appears in the downloaded JSON as "project_id"
# CLIENT_EMAIL appears in the downloaded JSON as "client_email"
# PRIVATE_KEY appears in the downloaded JSON as "private_key" (PEM). On Render
# you must escape the newlines — paste the value with literal \n sequences.
PROJECT_ID=your-project-id
CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n....\n-----END PRIVATE KEY-----\n"

# Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_VISION_MODEL=gemini-3.6-flash
GEMINI_TEXT_MODEL=gemini-3.6-flash

# CORS — deployed frontend origin (no trailing slash)
FRONTEND_URL=https://your-frontend.onrender.com