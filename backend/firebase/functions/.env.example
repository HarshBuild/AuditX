# ------------------------------------------------------------------
# AuditX backend — Render environment variables
# copy to .env (never commit .env) or set directly in Render dashboard
# run locally with:  npm run build && npm start
#   (the server auto-loads .env from the functions directory)
# ------------------------------------------------------------------

# Server
PORT=8080

# Firebase Admin (from Firebse Console > Project Settings > Service accounts > Generate new private key)
# PROJECT_ID appears in the downloaded JSON as "project_id"
# CLIENT_EMAIL appears in the downloaded JSON as "client_email"
# PRIVATE_KEY appears in the downloaded JSON as "private_key" (PEM). On Render
# you must escape the newlines — paste the value with literal \n sequences.
PROJECT_ID=your-project-id
CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n....\n-----END PRIVATE KEY-----\n"

# Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_VISION_MODEL=gemini-3.6-flash
GEMINI_TEXT_MODEL=gemini-3.6-flash

# CORS — deployed frontend origin(s) (no trailing slash). Comma-separated for
# multiple origins. FRONTEND_URL is also used by the API docs / tooling.
FRONTEND_URL=https://your-frontend.onrender.com
# CORS_ORIGINS=https://your-frontend.onrender.com

# Google Cloud Vision OCR (DOCUMENT_TEXT_DETECTION for small/dense label text)
# Paste the FULL service-account JSON from the GCP Console as ONE single-line
# string (Render secret). Never commit it. Alternatively point
# GOOGLE_APPLICATION_CREDENTIALS at a JSON file path on the server.
GOOGLE_VISION_CREDENTIALS_JSON={"type":"service_account",...}
# GOOGLE_APPLICATION_CREDENTIALS=/etc/secrets/vision.json

# ------------------------------------------------------------------
# MISA-style inspection pipeline
#   OCR_PROVIDER = 'mock' (demo, echoes typed details) or 'paddle' (real OCR
#                  via the Python microservice). Default: mock.
#   PYTHON_OCR_URL — base URL of the Python OCR service (default localhost:8100)
#   OCR_LANGS — default OCR language hint for the analysis (default en)
#   ASSISTANT_PROVIDER — reserved for an LLM-backed briefing; the current
#                        release ships a deterministic rule-based briefing.
# ------------------------------------------------------------------
# OCR_PROVIDER=mock
# PYTHON_OCR_URL=http://localhost:8100
# OCR_LANGS=en
# ASSISTANT_PROVIDER=rule-based