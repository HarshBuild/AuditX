{
  "name": "auditx-backend",
  "version": "1.0.0",
  "description": "AuditX standalone Node.js/Express backend for Render deployment",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "npm run build && node dist/server.js",
    "deploy": "echo 'Deploy to Render — run npm start on the Render Web Service'"
  },
  "engines": {
    "node": "20"
  },
  "dependencies": {
    "@google-cloud/vision": "^4.3.3",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "firebase-admin": "^12.7.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "typescript": "^5.6.3"
  }
}
