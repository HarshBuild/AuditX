# Copy to .env and fill from Supabase Dashboard → Project Settings → Data API.
# Example:
# VITE_SUPABASE_URL=https://hysiovajekyldmizmuhy.supabase.co
# VITE_SUPABASE_ANON_KEY=sb_publishable_...
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Backend API base URL for inspections / products / claims (Render service `AuditX-111`).
# Defaults to https://auditx-111.onrender.com when unset.
VITE_AUDITX_API_URL=
